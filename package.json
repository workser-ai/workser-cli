{
  "name": "@workser/cli",
  "version": "0.6.5",
  "description": "Workser CLI — give your local AI agent native DevOps & infrastructure on Workser. The agent runs `workser …` to provision, deploy, and manage real apps.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "workser": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/workser-ai/workser-cli.git"
  },
  "homepage": "https://docs.workser.ai/developers/cli",
  "bugs": {
    "url": "https://github.com/workser-ai/workser-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run build:help && tsup",
    "build:help": "node scripts/build-help.mjs",
    "dev": "npm run build:help && tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node dist/index.js",
    "test": "npm run build && vitest run",
    "preversion": "npm run typecheck && npm run test",
    "postversion": "git push -u origin HEAD && git push --tags && npm publish",
    "prepublishOnly": "npm run build && npm run typecheck && npm run test"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "typescript": "^5.9.0",
    "vitest": "^2.1.9"
  },
  "keywords": [
    "workser",
    "ai-agent",
    "devops",
    "deploy",
    "cli",
    "mcp",
    "claude-code",
    "codex"
  ]
}
